# ==============================================================================
# Cloudinary Credentials (Required for photo uploads & transformations)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================
# Production Server Configuration
# ==============================================================================
PORT=8000
HOST=0.0.0.0
DEBUG=false

# ==============================================================================
# CORS Configuration (Comma-separated URLs of deployed frontend)
# Example: https://eventsnap.vercel.app,https://mycustomdomain.com
# ==============================================================================
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# ==============================================================================
# Google Drive Folder Import (PRIMARY = Service Account; API key = public only)
# ==============================================================================
# Option A (PRIMARY): path to the service-account JSON key file (backend-only!)
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# Option A (alternative): raw JSON key content instead of a file path
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Option B (FALLBACK): API key, only works for "Anyone with the link" folders
GOOGLE_DRIVE_API_KEY=
# Safety cap on files imported per job
MAX_IMPORT_FILES=500
